# Copy to .env and fill in values. Never commit .env.

# CDF project name (same as in Cognite Data Fusion)
COGNITE_PROJECT=

# API host: set ONE of these (cluster builds https://<cluster>.cognitedata.com)
COGNITE_BASE_URL=https://api.cognitedata.com
# COGNITE_CLUSTER=

# OAuth2 client credentials (e.g. Azure AD / Entra)
COGNITE_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
COGNITE_CLIENT_ID=
COGNITE_CLIENT_SECRET=ß

# Space- or comma-separated scopes, e.g. https://<cluster>.cognitedata.com/.default
COGNITE_SCOPES=https://api.cognitedata.com/.default

# Optional: identifies this app to CDF (defaults to cdf-auth if unset)
# COGNITE_CLIENT_NAME=


DM_SYNC_VIEW_SPACE=shashanDataModel
DM_SYNC_VIEW_EXTERNAL_ID=Movie
DM_SYNC_VIEW_VERSION=1